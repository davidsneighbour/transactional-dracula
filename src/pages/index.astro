---
import '../styles/global.css';

const title = 'DNB service';
const description = 'A small service in the DNB universe.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#282a36" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fffbeb" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem('dnb-theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const useDark = storedTheme === 'dark' || (storedTheme !== 'light' && systemDark);
          document.documentElement.classList.toggle('dark', useDark);
        } catch (error) {
          console.warn('Unable to restore the DNB colour theme.', error);
        }
      })();
    </script>
  </head>

  <body>
    <main class="mx-auto flex min-h-svh w-full max-w-3xl items-center px-5 py-10 sm:px-8">
      <article
        class="w-full rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-6 py-7 shadow-sm sm:px-8 sm:py-9"
      >
        <div class="mb-8 flex items-center justify-between gap-4">
          <p class="m-0 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">
            DNB universe
          </p>

          <button
            id="theme-toggle"
            type="button"
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--surface-muted)] text-sm font-semibold text-[var(--text)] transition hover:border-[var(--primary)] hover:text-[var(--primary)]"
            aria-label="Toggle colour theme"
            title="Toggle colour theme"
          >
            <span aria-hidden="true">◐</span>
          </button>
        </div>

        <div class="prose prose-sm prose-dnb max-w-none">
          <h1>{title}</h1>
          <p>{description}</p>

          <p>
            This page is intentionally minimal. Replace this copy with the service description,
            status information, documentation, or endpoints that belong here.
          </p>

          <p>
            Example endpoint:
            <code>POST /deploy?event=&lt;event&gt;</code>
          </p>
        </div>

        <footer class="mt-9 border-t border-[var(--border)] pt-5 text-xs text-[var(--text-muted)]">
          davidsneighbour · DNB
        </footer>
      </article>
    </main>

    <script>
      const toggle = document.querySelector('#theme-toggle');

      if (!(toggle instanceof HTMLButtonElement)) {
        console.warn('DNB theme toggle was not found.');
      } else {
        toggle.addEventListener('click', () => {
          try {
            const root = document.documentElement;
            const dark = !root.classList.contains('dark');
            root.classList.toggle('dark', dark);
            localStorage.setItem('dnb-theme', dark ? 'dark' : 'light');
          } catch (error) {
            console.error('Unable to change the DNB colour theme.', error);
          }
        });
      }
    </script>
  </body>
</html>
